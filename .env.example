# Required: your xAI API key from https://console.x.ai/
XAI_API_KEY="xai-your-api-key-here"

# Optional: override the default vision model (defaults to grok-4.3 with fallbacks)
# XAI_MODEL="grok-4.3"

# Optional: change the local server port (default 3000)
# PORT=3000

# Folder where the combined export file is saved
EXPORT_OUTPUT_DIR=./exports

# Single master file — every export appends to this file
EXPORT_MASTER_FILE=Image Style Analyzer - All Exports.txt